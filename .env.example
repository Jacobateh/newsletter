# ---------------------------------------------------------------------------
# HAUSA ARABIA NEWSLETTER — ENVIRONMENT VARIABLES
#
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# Brevo credentials are SERVER-SIDE ONLY. They are read exclusively by the
# API route handlers under src/app/api/newsletter/* and lib/brevo.ts.
# Never prefix them with NEXT_PUBLIC_ and never use them in client components.
# ---------------------------------------------------------------------------

# 1) Brevo API v3 key
#    Create it at: https://app.brevo.com/settings/keys/api
#    Give it "Contacts" and "Transactional Email" permissions.
BREVO_API_KEY=

# 2) Numeric ID of the newsletter list
#    Found at: https://app.brevo.com/contacts/lists
#    Open your list and the ID is the number in the URL, e.g. 1234.
BREVO_LIST_ID=

# 3) Verified sender email for transactional emails
#    Set up and verify a sender at: https://app.brevo.com/senders/
#    (Use a dedicated inbox such as newsletter@hausa-arabia.com)
BREVO_SENDER_EMAIL=

# 4) Sender display name (optional, defaults to "Hausa Arabia")
BREVO_SENDER_NAME=Hausa Arabia

# 5) Public main-site URL used only for the "Back to Hausa Arabia" button.
#    This is a public navigation link, NOT a secret.
NEXT_PUBLIC_MAIN_SITE_URL=https://hausa-arabia.com
